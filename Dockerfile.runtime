# syntax=docker.io/docker/dockerfile:1

# Runtime-only image for the CI "build once, fan out" multi-arch strategy.
#
# This Dockerfile does NOT build the app. It expects the Next.js standalone
# output to already exist in the build context:
#   - .next/standalone
#   - .next/static
#   - public
#
# The Next.js build is plain, architecture-independent JavaScript (verified: no
# native .node binaries in the standalone trace), so the SAME prebuilt artifacts
# are reused for every target platform. CI runs `next build` once natively on
# amd64 and this image just copies the result — no expensive QEMU rebuild.
#
# For a fully self-contained build (local dev), use ./Dockerfile instead.

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

# Copy prebuilt artifacts from the build context
COPY public ./public
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static

USER nextjs
EXPOSE 8084
ENV PORT=8084
ENV HOSTNAME="0.0.0.0"
# server.js is produced by Next.js with output: 'standalone'
CMD ["node", "server.js"]
