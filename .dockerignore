# Default ignore file, used by the self-contained ./Dockerfile.
# The build stage reinstalls deps and rebuilds Next, so local copies of these
# must NOT leak into the build context (they would clobber the clean install).
node_modules
.next
.source
out
build
coverage
*.tsbuildinfo

.git
.github

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env*.local
.vercel
